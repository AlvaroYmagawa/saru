{
  "description": "Saru's send guard: a Slack message, Notion comment or Gmail email only goes out if its text went through saru:polish.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__slack_(send_message|send_message_draft|schedule_message)|mcp__.*__notion-create-comment|mcp__.*Gmail.*__(send_message|create_draft|reply|forward|update_draft)",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.cjs\"", "timeout": 10 }]
      }
    ]
  }
}
